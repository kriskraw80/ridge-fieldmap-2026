<metadata><name>High Point - east side (Oct 28)</name></metadata>
<wpt lat="41.32095" lon="-74.66160"><name>1 START - monument base (surveyed)</name><sym>Flag, Green</sym></wpt>
<wpt lat="41.32511" lon="-74.65860"><name>2 - on the trail - 1727 ft from the monument base at 1727 ft elevation</name><sym>Flag, Red</sym></wpt>
<wpt lat="41.32481" lon="-74.65795"><name>3 - 208 ft below the trail - 1727 ft from the monument base at 1727 ft elevation</name><sym>Flag, Blue</sym></wpt>
<wpt lat="41.32430" lon="-74.65714"><name>4 straight-line 1727 ft at 45 deg (east face, about 1650 ft)</name><sym>Waypoint</sym></wpt>
<wpt lat="41.32151" lon="-74.65791"><name>5 to-scale X - about 1000 ft east of the monument (1610 ft) - only if Friday's ruler says so</name><sym>Waypoint</sym></wpt>
